<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="BenchmarkConfig.fs" />
    <Compile Include="Utilities.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lib\FORM.fsproj" />
    <ProjectReference Include="..\Attributes\Attributes.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="benchmarkdotnet" Version="0.14.0" />
    <PackageReference Include="BenchmarkDotNet.Diagnostics.dotTrace" Version="0.14.0" />
    <PackageReference Include="dotnetenv" Version="3.1.1" />
    <PackageReference Include="dapper" Version="2.1.35" />
    <PackageReference Include="system.data.sqlite" Version="1.0.119" />
  </ItemGroup>

</Project>
